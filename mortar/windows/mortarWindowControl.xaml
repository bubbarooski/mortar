<UserControl x:Class="mortar.windows.mortarWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:mortar.models"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,8,8,4">
            <TextBlock Text="mortar"
                       FontSize="14"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
            <Button Content="Refresh"
                    Click="refreshClick"
                    Padding="8,2"
                    VerticalAlignment="Center"
                    Margin="0,0,6,0"
                    Background="{DynamicResource {x:Static vsshell:VsBrushes.ButtonFaceKey}}"
                    Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ButtonTextKey}}"
                    BorderBrush="Transparent"/>
            <ToggleButton Name="syncToggle"
                          Content="Sync"
                          IsChecked="True"
                          Click="syncToggleClick"
                          VerticalAlignment="Center"
                          Margin="0,0,6,0">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Padding" Value="8,2"/>
                        <Setter Property="Background"
                                Value="{DynamicResource {x:Static vsshell:VsBrushes.ButtonFaceKey}}"/>
                        <Setter Property="Foreground"
                                Value="{DynamicResource {x:Static vsshell:VsBrushes.ButtonTextKey}}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="BorderBrush"
                                        Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
            <TextBlock Name="gitWarningText"
                       Text="⚠ uncommitted changes"
                       FontSize="10"
                       VerticalAlignment="Center"
                       Margin="6,0,0,0"
                       Foreground="Orange"
                       Visibility="Collapsed"/>
        </StackPanel>

        <!-- No solution open message -->
        <TextBlock Grid.Row="1"
                   Name="noSolutionText"
                   Text="Open a solution to get started."
                   Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>

        <!-- No links message -->
        <TextBlock Grid.Row="1"
                   Name="noLinksText"
                   Text="No links found. Use mortar-cli to add links."
                   Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>

        <!-- Tree view -->
        <TreeView Grid.Row="1"
                  Name="linksTree"
                  Margin="4"
                  Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                  Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                  BorderThickness="0"
                  Visibility="Collapsed">
            <TreeView.Resources>

                <Style TargetType="TreeViewItem">
                    <Setter Property="Background"
                            Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"/>
                    <Setter Property="Foreground"
                            Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background"
                                    Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <!-- Notes child row template -->
                <DataTemplate DataType="{x:Type local:detailNode}">
                    <TextBlock Text="{Binding text}"
                               Margin="4,2,0,2"
                               FontSize="11"
                               Opacity="0.7"
                               TextWrapping="Wrap"
                               MaxWidth="300"
                               Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                </DataTemplate>

                <!-- Document row template -->
                <HierarchicalDataTemplate DataType="{x:Type local:documentNode}"
                                          ItemsSource="{Binding children}">
                    <StackPanel Orientation="Horizontal"
                                Margin="2"
                                Cursor="Hand"
                                MouseLeftButtonUp="documentNodeClicked">
                        <StackPanel.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding notes}"
                                          IsEnabled="False"
                                          FontStyle="Italic"
                                          Visibility="{Binding notesVisibility}"/>
                                <Separator Visibility="{Binding notesVisibility}"/>
                                <MenuItem Header="Open" Click="contextMenuOpen"/>
                                <MenuItem Header="Copy Path" Click="contextMenuCopyPath"/>
                            </ContextMenu>
                        </StackPanel.ContextMenu>

                        <!-- Status dot -->
                        <Ellipse Width="10"
                                 Height="10"
                                 Margin="0,0,6,0"
                                 VerticalAlignment="Center"
                                 Fill="{Binding dotColor}"/>

                        <!-- Display name -->
                        <TextBlock VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="Green"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding isOutOfDate}" Value="True">
                                            <Setter Property="Foreground" Value="Red"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <TextBlock.Text>
                                <Binding Path="displayName"/>
                            </TextBlock.Text>
                        </TextBlock>

                        <!-- Primary label -->
                        <TextBlock VerticalAlignment="Center"
                                   Margin="6,0,0,0"
                                   FontSize="10"
                                   Opacity="0.5"
                                   Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding isPrimary}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <TextBlock.Text>primary</TextBlock.Text>
                        </TextBlock>

                    </StackPanel>
                </HierarchicalDataTemplate>

                <!-- Source file row template -->
                <HierarchicalDataTemplate DataType="{x:Type local:sourceFileNode}"
                                          ItemsSource="{Binding documents}">
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <TextBlock Text="📄 " VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding displayName}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                    </StackPanel>
                </HierarchicalDataTemplate>

            </TreeView.Resources>
        </TreeView>

    </Grid>
</UserControl>