<UserControl x:Class="mortar.windows.mortarWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:mortar.models"
             xmlns:windows="clr-namespace:mortar.windows"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}">

    <UserControl.Resources>
        <local:docTypeDisplayConverter x:Key="docTypeConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,8,8,4">
            <TextBlock Text="mortar"
                       FontSize="14"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
            <Button Content="Add Link"
                    Click="headerAddLink"
                    Padding="8,2"
                    VerticalAlignment="Center"
                    Margin="0,0,6,0"
                    Background="{DynamicResource {x:Static vsshell:VsBrushes.ButtonFaceKey}}"
                    Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ButtonTextKey}}"
        BorderBrush="Transparent"/>
            <Button Content="Refresh"
                    Click="refreshClick"
                    Padding="8,2"
                    VerticalAlignment="Center"
                    Margin="0,0,6,0"
                    Background="{DynamicResource {x:Static vsshell:VsBrushes.ButtonFaceKey}}"
                    Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ButtonTextKey}}"
                    BorderBrush="Transparent"/>
            <ToggleButton Name="syncToggle"
                          IsChecked="True"
                          Click="syncToggleClick"
                          VerticalAlignment="Center"
                          Margin="0,0,6,0">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Padding" Value="8,2"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Content" Value="Sync: On"/>
                        <Setter Property="Foreground" Value="Green"/>
                        <Setter Property="Background"
                                Value="{DynamicResource {x:Static vsshell:VsBrushes.ButtonFaceKey}}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Content" Value="Sync: On"/>
                                <Setter Property="Foreground" Value="Green"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Content" Value="Sync: Off"/>
                                <Setter Property="Foreground" Value="Red"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
        </StackPanel>

        <!-- Git warning banner -->
        <!-- Git warning banner -->
        <Border Grid.Row="1"
        Name="gitWarningBanner"
        Background="#3D2E00"
        Padding="8,4"
        Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="⚠ "
                       Foreground="Orange"
                       VerticalAlignment="Center"/>
                    <TextBlock Text="doclinks.json has uncommitted changes."
                       Foreground="Orange"
                       FontSize="11"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1"
                Content="✕"
                Click="dismissGitWarning"
                Foreground="Orange"
                Background="Transparent"
                BorderBrush="Transparent"
                Padding="4,0"
                VerticalAlignment="Center"
                Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- No solution open message -->
        <TextBlock Grid.Row="2"
                   Name="noSolutionText"
                   Text="Open a solution to get started."
                   Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>

        <!-- No links message -->
        <TextBlock Grid.Row="2"
                   Name="noLinksText"
                   Text="No links found. Use mortar-cli to add links."
                   Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>

        <!-- Tree view -->
        <TreeView Grid.Row="2"
                  Name="linksTree"
                  Margin="4"
                  Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                  Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                  BorderThickness="0"
                  Visibility="Collapsed">
            <TreeView.Resources>

                <Style TargetType="TreeViewItem">
                    <Setter Property="Background"
                            Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"/>
                    <Setter Property="Foreground"
                            Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background"
                                    Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <!-- Notes child row template -->
                <DataTemplate DataType="{x:Type local:detailNode}">
                    <TextBlock Text="{Binding text}"
                               Margin="4,2,0,2"
                               FontSize="11"
                               Opacity="0.7"
                               TextWrapping="Wrap"
                               MaxWidth="300"
                               Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                </DataTemplate>

                <!-- Document row template -->
                <HierarchicalDataTemplate DataType="{x:Type local:documentNode}"
                                          ItemsSource="{Binding children}">
                    <HierarchicalDataTemplate.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="Visibility"
                                    Value="{Binding childrenVisibility}"/>
                        </Style>
                    </HierarchicalDataTemplate.ItemContainerStyle>
                    <StackPanel>

                        <!-- Normal row -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="2"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="documentNodeClicked">
                            <StackPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{Binding notes}"
                                              IsEnabled="False"
                                              FontStyle="Italic"
                                              Visibility="{Binding notesVisibility}"/>
                                    <Separator Visibility="{Binding notesVisibility}"/>
                                    <MenuItem Header="Open" Click="contextMenuOpen"/>
                                    <MenuItem Header="Copy Path" Click="contextMenuCopyPath"/>
                                    <Separator/>
                                    <MenuItem Header="Edit" Click="contextMenuEdit"/>
                                </ContextMenu>
                            </StackPanel.ContextMenu>

                            <!-- Status dot -->
                            <Ellipse Width="10"
                                     Height="10"
                                     Margin="0,0,6,0"
                                     VerticalAlignment="Center"
                                     Fill="{Binding dotColor}"/>

                            <!-- Display name -->
                            <TextBlock VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="Green"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding isOutOfDate}" Value="True">
                                                <Setter Property="Foreground" Value="Red"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <TextBlock.Text>
                                    <Binding Path="displayName"/>
                                </TextBlock.Text>
                            </TextBlock>

                            <!-- Primary label -->
                            <TextBlock VerticalAlignment="Center"
                                       Margin="6,0,0,0"
                                       FontSize="10"
                                       Opacity="0.5"
                                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding isPrimary}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <TextBlock.Text>primary</TextBlock.Text>
                            </TextBlock>

                        </StackPanel>

                        <!-- Edit panel -->
                        <StackPanel Margin="16,4,4,8">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding isEditing}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Nickname -->
                            <TextBlock Text="Nickname"
                                       FontSize="10"
                                       Opacity="0.6"
                                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                            <TextBox Text="{Binding editNickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,2,0,6"
                                     Padding="4,2"
                                     Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                                     Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                                     BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>

                            <!-- Path -->
                            <TextBlock Text="Path"
                                       FontSize="10"
                                       Opacity="0.6"
                                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                            <TextBox Text="{Binding editPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,2,0,6"
                                     Padding="4,2"
                                     Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                                     Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                                     BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>

                            <!-- URL -->
                            <TextBlock Text="URL"
                                       FontSize="10"
                                       Opacity="0.6"
                                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                            <TextBox Text="{Binding editUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,2,0,6"
                                     Padding="4,2"
                                     Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                                     Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                                     BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>

                            <!-- Doc Type -->
                            <TextBlock Text="Type"
                                       FontSize="10"
                                       Opacity="0.6"
                                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                            <ComboBox SelectedValue="{Binding editDocType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=docTypeOptions}"
                                      Margin="0,2,0,6"
                                      Padding="4,2">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource docTypeConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="Background"
                                                Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"/>
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ComboBox">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="20"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.ColumnSpan="2"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"/>
                                                        <ContentPresenter Grid.Column="0"
                                                                          Margin="4,2,0,2"
                                                                          VerticalAlignment="Center"
                                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                                        <Path Grid.Column="1"
                                                              Data="M 0 0 L 4 4 L 8 0 Z"
                                                              Fill="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                        <ToggleButton Grid.ColumnSpan="2"
                                                                      Opacity="0"
                                                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                                               Placement="Bottom"
                                                               AllowsTransparency="True">
                                                            <Border Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                                                                    BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                                                                    BorderThickness="1"
                                                                    MinWidth="{TemplateBinding ActualWidth}">
                                                                <ScrollViewer>
                                                                    <ItemsPresenter/>
                                                                </ScrollViewer>
                                                            </Border>
                                                        </Popup>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ComboBox.Style>
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background"
                                                Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"/>
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}"/>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightTextKey}}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>

                            <!-- Notes -->
                            <TextBlock Text="Notes"
                                       FontSize="10"
                                       Opacity="0.6"
                                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                            <TextBox Text="{Binding editNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,2,0,6"
                                     Padding="4,2"
                                     Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                                     Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                                     BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>

                            <!-- Save and Cancel buttons -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="Save"
                                        Click="saveEdit"
                                        Padding="8,2"
                                        Margin="0,0,6,0"
                                        Background="{DynamicResource {x:Static vsshell:VsBrushes.ButtonFaceKey}}"
                                        Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ButtonTextKey}}"
                                        BorderBrush="Transparent"/>
                                <Button Content="Cancel"
                                        Click="cancelEdit"
                                        Padding="8,2"
                                        Background="{DynamicResource {x:Static vsshell:VsBrushes.ButtonFaceKey}}"
                                        Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ButtonTextKey}}"
                                        BorderBrush="Transparent"/>
                            </StackPanel>

                        </StackPanel>

                    </StackPanel>
                </HierarchicalDataTemplate>

                <!-- Source file row template -->
                <HierarchicalDataTemplate DataType="{x:Type local:sourceFileNode}"
                          ItemsSource="{Binding documents}">
                    <StackPanel>

                        <!-- Source file row -->
                        <StackPanel Orientation="Horizontal"
                    Margin="2">
                            <StackPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Add Link" Click="contextMenuAddLink"/>
                                </ContextMenu>
                            </StackPanel.ContextMenu>
                            <TextBlock Text="📄 " VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding displayName}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                        </StackPanel>

                        <!-- Add link panel -->
                        <StackPanel Margin="16,4,4,8">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding isAddingLink}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Path -->
                            <TextBlock Text="Path"
                       FontSize="10"
                       Opacity="0.6"
                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                            <TextBox Name="newLinkPath"
                     Margin="0,2,0,6"
                     Padding="4,2"
                     Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                     Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                     BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>

                            <!-- URL -->
                            <TextBlock Text="URL"
                       FontSize="10"
                       Opacity="0.6"
                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                            <TextBox Name="newLinkUrl"
                     Margin="0,2,0,6"
                     Padding="4,2"
                     Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                     Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                     BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>

                            <!-- Nickname -->
                            <TextBlock Text="Nickname"
                       FontSize="10"
                       Opacity="0.6"
                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                            <TextBox Name="newLinkNickname"
                     Margin="0,2,0,6"
                     Padding="4,2"
                     Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                     Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                     BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>

                            <!-- Type -->
                            <TextBlock Text="Type"
                       FontSize="10"
                       Opacity="0.6"
                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                            <ComboBox Name="newLinkDocType"
                      ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=docTypeOptions}"
                      Margin="0,2,0,6"
                      Padding="4,2">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource docTypeConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="Background"
                                Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"/>
                                        <Setter Property="Foreground"
                                Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                                        <Setter Property="BorderBrush"
                                Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ComboBox">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="20"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.ColumnSpan="2"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"/>
                                                        <ContentPresenter Grid.Column="0"
                                                          Margin="4,2,0,2"
                                                          VerticalAlignment="Center"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                                        <Path Grid.Column="1"
                                              Data="M 0 0 L 4 4 L 8 0 Z"
                                              Fill="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                                        <ToggleButton Grid.ColumnSpan="2"
                                                      Opacity="0"
                                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                               Placement="Bottom"
                                               AllowsTransparency="True">
                                                            <Border Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                                                    BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                                                    BorderThickness="1"
                                                    MinWidth="{TemplateBinding ActualWidth}">
                                                                <ScrollViewer>
                                                                    <ItemsPresenter/>
                                                                </ScrollViewer>
                                                            </Border>
                                                        </Popup>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ComboBox.Style>
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background"
                                Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"/>
                                        <Setter Property="Foreground"
                                Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter Property="Background"
                                        Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}"/>
                                                <Setter Property="Foreground"
                                        Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightTextKey}}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>

                            <!-- Notes -->
                            <TextBlock Text="Notes"
                       FontSize="10"
                       Opacity="0.6"
                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                            <TextBox Name="newLinkNotes"
                     Margin="0,2,0,6"
                     Padding="4,2"
                     Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                     Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                     BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>

                            <!-- Primary -->
                            <CheckBox Content="Primary reference"
                      Name="newLinkPrimary"
                      Margin="0,0,0,6"
                      Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>

                            <!-- Save and Cancel -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="Add"
                        Click="saveNewLink"
                        Padding="8,2"
                        Margin="0,0,6,0"
                        Background="{DynamicResource {x:Static vsshell:VsBrushes.ButtonFaceKey}}"
                        Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ButtonTextKey}}"
                        BorderBrush="Transparent"/>
                                <Button Content="Cancel"
                        Click="cancelNewLink"
                        Padding="8,2"
                        Background="{DynamicResource {x:Static vsshell:VsBrushes.ButtonFaceKey}}"
                        Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ButtonTextKey}}"
                        BorderBrush="Transparent"/>
                            </StackPanel>

                        </StackPanel>

                    </StackPanel>
                </HierarchicalDataTemplate>

            </TreeView.Resources>
        </TreeView>

    </Grid>
</UserControl>